{
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string",
      "enum": [
        "Web",
        "APIs",
        "Mobile",
        "Desktop",
        "CLI Tools",
        "Browser Extensions",
        "Libraries",
        "Developer Tools",
        "Education",
        "Data & Analytics",
        "Games",
        "Security",
        "Automation",
        "Other"
      ]
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string",
        "enum": [
          "android",
          "arch-linux",
          "astro",
          "aur",
          "automation",
          "cli",
          "css",
          "data",
          "dataset",
