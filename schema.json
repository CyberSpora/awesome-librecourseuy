      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Repository",
      "type": "string"
    },
    "open_to_contributions": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Open To Contributions"
    }
