      "type": "array"
    },
    "language": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Language",
      "type": "array"
    },
    "maintainers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Maintainers",
      "type": "array"
