          "astro",
          "aur",
          "automation",
          "cli",
          "css",
          "data",
          "dataset",
          "docker",
          "fastapi",
          "firefox",
          "flutter",
          "game",
          "geolocation",
          "go",
          "hugo",
          "javascript",
          "linux",
          "moodle",
          "music",
          "musicbrainz",
          "offline",
          "open-data",
          "openstreetmap",
          "postgres",
          "privacy",
          "python",
