        "type": "string"
      },
      "title": "Language",
      "type": "array"
    },
    "maintainers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Maintainers",
      "type": "array"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
