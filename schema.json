      "type": "string"
    },
    "open_source": {
      "title": "Open Source",
      "type": "boolean"
    },
    "repository": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
